{
  "path": ["src"],
  "format": ["typescript"],
  "minLines": 5,
  "minTokens": 50,
  "absolute": true,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "src/migrations/**",
    "**/*.spec.ts"
  ],
  "reporters": ["console", "html"],
  "output": "reports/jscpd",
  "threshold": 0
}
