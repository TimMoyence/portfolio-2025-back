    ],
    "type": "object",
  },
  "SetPasswordDto": {
    "properties": {
      "newPassword": {
        "example": "NewPassword456!",
        "maxLength": 256,
        "minLength": 12,
        "pattern": "^(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).+$",
        "type": "string",
      },
    },
    "required": [
      "newPassword",
    ],
    "type": "object",
  },
  "SubscribeNewsletterRequestDto": {
    "properties": {
      "email": {
        "example": "marie@example.com",
        "format": "email",
        "type": "string",
      },
      "firstName": {
        "example": "Marie",
        "maxLength": 50,
        "type": "string",
      },
      "formFillDurationMs": {
        "description": "Durée de saisie en ms, mesurée par le poste sur une horloge monotone",
        "minimum": 0,
        "type": "integer",
      },
      "formStartedAt": {
        "deprecated": true,
        "description": "Timestamp ms d'ouverture du formulaire, pris sur l'horloge du poste : accepté, jamais comparé",
        "minimum": 0,
        "type": "integer",
      },
      "locale": {
        "enum": [
          "fr",
          "en",
        ],
        "example": "fr",
        "type": "string",
      },
      "sourceFormationSlug": {
        "enum": [
          "ia-solopreneurs",
          "automatiser-avec-ia",
          "veille-ia",
        ],
        "example": "ia-solopreneurs",
        "maxLength": 100,
        "minLength": 1,
        "type": "string",
      },
      "termsAcceptedAt": {
        "example": "2026-04-10T10:00:00.000Z",
        "format": "date-time",
        "type": "string",
      },
      "termsVersion": {
        "example": "2026-04-10",
        "maxLength": 50,
        "minLength": 1,
        "type": "string",
      },
      "website": {
        "description": "Champ piège anti-robot, doit rester vide",
        "maxLength": 200,
        "type": "string",
      },
    },
    "required": [
      "email",
      "locale",
      "sourceFormationSlug",
      "termsVersion",
      "termsAcceptedAt",
    ],
    "type": "object",
  },
  "UpdateProfileDto": {
    "properties": {
      "firstName": {
        "example": "Jean",
        "maxLength": 50,
        "minLength": 1,
        "type": "string",
      },
      "lastName": {
        "example": "Dupont",
        "maxLength": 50,
        "minLength": 1,
        "type": "string",
      },
      "phone": {
        "example": "+33612345678",
        "maxLength": 30,
        "nullable": true,
        "type": "string",
      },
    },
    "type": "object",
  },
  "UpdateUserDto": {
    "properties": {
      "email": {
        "example": "john@example.com",
        "format": "email",
        "type": "string",
      },
      "firstName": {
        "example": "John",
        "maxLength": 50,
        "minLength": 1,
        "type": "string",
      },
      "isActive": {
        "example": true,
        "type": "boolean",
      },
      "lastName": {
        "example": "Doe",
        "maxLength": 50,
        "minLength": 1,
        "type": "string",
      },
      "password": {
        "example": "StrongPassword123!",
        "maxLength": 256,
        "minLength": 12,
        "pattern": "^(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).+$",
        "type": "string",
      },
      "phone": {
        "example": "+11234567890",
        "maxLength": 30,
        "nullable": true,
        "type": "string",
      },
      "roles": {
        "description": "Liste des roles. Reserve aux administrateurs.",
        "example": [
          "teacher",
        ],
        "items": {
          "enum": [
            "admin",
            "teacher",
          ],
          "type": "string",
        },
        "type": "array",
      },
    },
    "type": "object",
  },
  "UserResponseDto": {
    "properties": {
      "createdAt": {
        "example": "2025-01-01T00:00:00.000Z",
        "type": "string",
      },
      "email": {
        "example": "john@example.com",
        "type": "string",
      },
      "emailVerified": {
        "description": "Indique si l'adresse email a ete verifiee.",
        "example": true,
        "type": "boolean",
      },
      "firstName": {
        "example": "John",
        "type": "string",
      },
      "hasPassword": {
        "description": "Indique si le compte a un mot de passe defini.",
        "example": true,
        "type": "boolean",
      },
      "id": {
        "example": "08bcd3fe-0d1d-4db6-9ee4-5a6a65c13c45",
        "type": "string",
      },
      "isActive": {
        "example": true,
        "type": "boolean",
      },
      "lastName": {
        "example": "Doe",
        "type": "string",
      },
      "phone": {
        "example": "+11234567890",
        "nullable": true,
        "type": "string",
      },
      "roles": {
        "example": [
          "teacher",
        ],
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "updatedAt": {
        "example": "2025-01-02T00:00:00.000Z",
        "type": "string",
      },
      "updatedOrCreatedBy": {
        "example": "system",
        "nullable": true,
        "type": "string",
      },
    },
    "required": [
      "id",
      "email",
      "firstName",
      "lastName",
      "isActive",
      "roles",
      "createdAt",
      "hasPassword",
      "emailVerified",
    ],
    "type": "object",
  },
}
`;

