    "required": [
      "questionId",
      "valeur",
      "dureeMs",
    ],
    "type": "object",
  },
  "SubmitProductionResponseDto": {
    "properties": {
      "correcte": {
        "example": false,
        "type": "boolean",
      },
      "details": {
        "items": {
          "$ref": "#/components/schemas/DetailVerdictResponseDto",
        },
        "type": "array",
      },
      "libelleConfusion": {
        "description": "Libelle de la confusion la plus frequente du detail",
        "nullable": true,
        "type": "string",
      },
      "score": {
        "description": "Part des attendus justes, de 0 a 1",
        "example": 0.7647,
        "type": "number",
      },
    },
    "required": [
      "correcte",
      "score",
      "details",
      "libelleConfusion",
    ],
    "type": "object",
  },
  "SujetResponseDto": {
    "properties": {
      "concepts": {
        "example": [
          "proportion",
        ],
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "duree": {
        "description": "Duree du cours en minutes",
        "example": 195,
        "type": "number",
      },
      "ecrans": {
        "items": {
          "$ref": "#/components/schemas/EcranPublicResponseDto",
        },
        "type": "array",
      },
      "id": {
        "description": "Slug du cours",
        "example": "b2-01-traitement-information-chiffree",
        "type": "string",
      },
      "niveau": {
        "example": "B2",
        "type": "string",
      },
      "titre": {
        "example": "Proportions, taux et évolutions",
        "type": "string",
      },
    },
    "required": [
      "id",
      "titre",
      "niveau",
      "duree",
      "concepts",
      "ecrans",
    ],
    "type": "object",
  },
  "SyntheseConceptResponseDto": {
    "properties": {
      "boite1": {
        "example": 6,
        "type": "number",
      },
      "boite2": {
        "example": 14,
        "type": "number",
      },
      "boite3": {
        "example": 3,
        "type": "number",
      },
      "concept": {
        "example": "evolution-reciproque",
        "type": "string",
      },
      "libelle": {
        "example": "Évolution réciproque",
        "type": "string",
      },
      "nonVus": {
        "example": 1,
        "type": "number",
      },
    },
    "required": [
      "concept",
      "libelle",
      "boite1",
      "boite2",
      "boite3",
      "nonVus",
    ],
    "type": "object",
  },
  "SyntheseRappelsResponseDto": {
    "properties": {
      "concepts": {
        "items": {
          "$ref": "#/components/schemas/SyntheseConceptResponseDto",
        },
        "type": "array",
      },
    },
    "required": [
      "concepts",
    ],
    "type": "object",
  },
  "TentativeEnigmeResponseDto": {
    "properties": {
      "correcte": {
        "example": true,
        "type": "boolean",
      },
      "fragment": {
        "description": "Fragment du code, livre seulement a la resolution",
        "example": "7",
        "nullable": true,
        "type": "string",
      },
      "tentativesRestantes": {
        "example": 9,
        "maximum": 10,
        "minimum": 0,
        "type": "number",
      },
    },
    "required": [
      "correcte",
      "fragment",
      "tentativesRestantes",
    ],
    "type": "object",
  },
  "TenterEnigmeRequestDto": {
    "properties": {
      "dureeMs": {
        "example": 42000,
        "type": "number",
      },
      "enigmeId": {
        "example": "enigme-1",
        "type": "string",
      },
      "reponse": {
        "description": "Saisie brute, lue par lireNombreSaisi pour une solution chiffree",
        "example": "142 920",
        "type": "string",
      },
    },
    "required": [
      "enigmeId",
      "reponse",
      "dureeMs",
    ],
    "type": "object",
  },
  "ToleranceResponseDto": {
    "properties": {
      "type": {
        "enum": [
          "relative",
          "absolue",
          "decimales",
        ],
        "type": "string",
      },
      "valeur": {
        "example": 0.0001,
        "type": "number",
      },
    },
    "required": [
      "type",
      "valeur",
    ],
    "type": "object",
  },
}
`;

