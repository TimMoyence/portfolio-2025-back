NODE_ENV=development
PORT=3000

# --- API ---
API_PREFIX=/api/v1/portfolio25
SWAGGER_PATH=docs
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4000

# --- Database (PostgreSQL 16) ---
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=portfolio_2025_dev
DB_SSL=false
DB_SYNCHRONIZE=false

# --- Security (generate your own: openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
SECURE_KEY_FOR_PASSWORD_HASHING=CHANGE_ME_generate_with_openssl_rand_base64_48
# Access token TTL: 900s (15min) recommande par OWASP pour limiter
# l'impact d'une compromission. Le refresh token (rotation) compense.
JWT_EXPIRES_IN=900s
# Obligatoire : identifiant client OAuth Google (console Google Cloud).
# La valeur d'exemple laisse demarrer l'API ; seule la connexion Google echoue.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
PASSWORD_RESET_URL_BASE=https://asilidesign.fr/reset-password

# --- Formations : cloture de session et rapports ---
# Obligatoire : destinataire de la synthese formateur quand la cloture
# n'a pas recu d'adresse explicite. Jamais teacherId (voir
# CloseSessionUseCase, Ruling 54) : teacherId est un identifiant opaque,
# pas une adresse email.
FORMATION_TEACHER_NOTIFICATION_TO=CHANGE_ME_admin@example.com
FORMATION_REVIEW_BASE_URL=https://asilidesign.fr/cours/revision
# Cle HMAC du lien de revision individuel envoye a chaque etudiant.
# Obligatoire : sans elle, la cloture de session reussit toujours mais
# aucune copie etudiante n'est envoyee (voir CloseSessionUseCase).
FORMATION_REVIEW_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
FORMATIONS_PULSE_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# --- Articles Morning-Brief ---
# Production : stocker la valeur dans le secret manager, jamais dans Git.
# Format du trousseau : key-id:secret,key-id-2:secret-2
MORNING_BRIEF_HMAC_KEYS=
# Alternative mono-clé pour les environnements simples : KEY_ID et SECRET
# se renseignent ensemble ou se laissent vides tous les deux (hors production).
MORNING_BRIEF_HMAC_KEY_ID=morning-brief
MORNING_BRIEF_HMAC_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# --- Redis : files BullMQ (audit, badges) et plafond partage des flux SSE ---
# Meme topologie qu'en production (deploy/backend.env.example, service `redis`
# de deploy/compose.yaml). REDIS_URL est lu avant REDIS_HOST/REDIS_PORT.
# Redis local : docker run --rm -p 6379:6379 redis:7-alpine
#
# Redis est actif si et seulement si REDIS_URL ou REDIS_HOST est renseigne.
# Sans Redis joignable alors qu'il est configure, les flux SSE des formations
# sont refuses (429) et les files repassent en execution locale apres trois
# erreurs.
# Pour developper sans Redis, supprimez REDIS_URL et REDIS_HOST ou laissez-les
# vides : les files s'executent dans le processus (AUDIT_QUEUE_ENABLED reste
# sans effet) et le plafond des flux SSE n'est tenu qu'en memoire, par
# instance. REDIS_PORT (6379 par defaut) ne sert qu'avec REDIS_HOST.
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Queue (BullMQ) ---
AUDIT_QUEUE_ENABLED=true
AUDIT_QUEUE_NAME=audit_requests
AUDIT_QUEUE_CONCURRENCY=1
AUDIT_QUEUE_ATTEMPTS=3
AUDIT_QUEUE_BACKOFF_MS=2000
AUDIT_JOB_TIMEOUT_MS=180000

# --- Audit fetch ---
AUDIT_FETCH_TIMEOUT_MS=8000
AUDIT_MAX_REDIRECTS=5
AUDIT_HTML_MAX_BYTES=1000000
AUDIT_TEXT_MAX_BYTES=1000000
AUDIT_SITEMAP_SAMPLE_SIZE=10
AUDIT_SITEMAP_MAX_URLS=50000
AUDIT_SITEMAP_ANALYZE_LIMIT=150
AUDIT_URL_ANALYZE_CONCURRENCY=6
AUDIT_PAGE_ANALYZE_LIMIT=20
AUDIT_PAGE_AI_CONCURRENCY=2
AUDIT_PAGE_AI_TIMEOUT_MS=8000

# --- LLM (OpenAI) — optional, audit works in fallback mode without it ---
OPENAI_API_KEY=
AUDIT_LLM_MODEL=gpt-4o-mini
AUDIT_LLM_PROFILE=parallel_sections_v1
AUDIT_LLM_LANGUAGE=fr

# --- SMTP — optional, contact form notifications ---
# SMTP_FROM devient OBLIGATOIRE des que SMTP_HOST, SMTP_USER et SMTP_PASS
# sont tous renseignes : sans expediteur, nodemailer echoue a l'envoi en
# production, bien apres le demarrage. L'API refuse alors de demarrer
# plutot que de laisser passer une configuration inoperante — retirer
# SMTP_FROM d'un serveur ou SMTP est configure met donc toute l'API a
# l'arret, pas seulement l'envoi d'emails.
# Formats acceptes : `adresse@domaine` ou `'Nom' <adresse@domaine>`.
#
# Signature DKIM (optionnelle) : renseigner les TROIS variables
# SMTP_DKIM_DOMAIN / SMTP_DKIM_SELECTOR / SMTP_DKIM_PRIVATE_KEY pour que
# l'API signe elle-meme les messages. La RFC 8058 §4 exige que les
# en-tetes List-Unsubscribe soient couverts par la signature, sans quoi
# Gmail ignore le bouton natif de desabonnement. Si ces variables sont
# absentes, la signature reste a la charge du relais SMTP — verifier
# alors le tag `h=` sur un message reel (« Afficher l'original »).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="'Portfolio' <no-reply@example.com>"
CONTACT_NOTIFICATION_TO=
AUDIT_REPORT_TO=

# --- Weather (OpenWeatherMap) ---
OPENWEATHERMAP_API_KEY=

# --- Metrics (Prometheus scraping) ---
# Token statique pour proteger le endpoint /metrics.
# Si absent, le endpoint retourne 403. Generer avec : openssl rand -base64 32
METRICS_TOKEN=

# --- Telegram Bot (Sebastian) ---
TELEGRAM_BOT_TOKEN=
