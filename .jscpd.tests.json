{
  "path": ["src", "test"],
  "format": ["typescript"],
  "minLines": 5,
  "minTokens": 30,
  "maxLines": 100000,
  "maxSize": "10mb",
  "absolute": true,
  "gitignore": true,
  "pattern": "{src/**/*.spec.ts,test/**/*.ts}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "src/migrations/**"
  ],
  "reporters": ["console", "html"],
  "output": "reports/jscpd-tests",
  "threshold": 0
}
